# Upstash/Vercel Redis REST credentials (set these in Vercel, not in Git)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Must match DEVICE_API_KEY in local arduino_secrets.h
FLIGHTLAB_DEVICE_KEY=

# Demonstration temperature reference only; not diagnostic thresholds
TEMPERATURE_MIN_C=30.2
TEMPERATURE_MAX_C=33.0

# Enter after testing dry and wet assembled electrodes
MOISTURE_DRY_CALIBRATION_PF=
MOISTURE_WET_CALIBRATION_PF=

# Configure the exhibition target only after moisture calibration
MOISTURE_MIN_PERCENT=
MOISTURE_MAX_PERCENT=
